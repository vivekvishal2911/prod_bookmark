{
  "manifest_version": 3,
  "name": "Bookmarks Board",
  "version": "2.1.0",
  "description": "A Papaly-style bookmark dashboard on your new tab. Click the toolbar icon to save the current page with a custom name.",
  "permissions": ["storage", "activeTab", "favicon"],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save this page to Bookmarks Board",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
